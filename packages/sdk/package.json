{
  "name": "@spectyra/sdk",
  "version": "0.1.19",
  "description": "Spectyra SDK for real-time LLM optimization",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adapters/openai": {
      "types": "./dist/adapters/openai.d.ts",
      "default": "./dist/adapters/openai.js"
    },
    "./adapters/anthropic": {
      "types": "./dist/adapters/anthropic.d.ts",
      "default": "./dist/adapters/anthropic.js"
    },
    "./adapters/groq": {
      "types": "./dist/adapters/groq.d.ts",
      "default": "./dist/adapters/groq.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "RELEASE.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build",
    "publish:npm": "node ../../tools/npm-publish-spectyra.mjs",
    "test:sdk-moat-summaries": "tsx src/__tests__/sdkMoatSummaries.test.ts",
    "test:optimization-engine-parity": "tsx src/__tests__/optimizationEngineParity.test.ts",
    "test:telemetry-privacy": "tsx src/__tests__/telemetryPrivacy.test.ts",
    "test:resolve-api-base-url": "tsx src/__tests__/resolveApiBaseUrl.test.ts",
    "test:resolve-effective-telemetry": "tsx src/__tests__/resolveEffectiveTelemetryMode.test.ts",
    "test:monitor-core": "tsx src/__tests__/monitorCore.test.ts",
    "test:monitor-complete": "tsx src/__tests__/monitorCompleteIntegration.test.ts"
  },
  "keywords": [
    "llm",
    "optimization",
    "token-reduction",
    "spectyra",
    "claude",
    "agent",
    "sdk"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spectyra/spectyra.git",
    "directory": "packages/sdk"
  },
  "dependencies": {},
  "devDependencies": {
    "@spectyra/analytics-core": "workspace:^0.1.0",
    "@spectyra/canonical-model": "workspace:^0.1.0",
    "@spectyra/core-types": "workspace:^0.1.0",
    "@spectyra/event-adapters": "workspace:^0.1.0",
    "@spectyra/event-core": "workspace:^0.1.0",
    "@spectyra/execution-graph": "workspace:^0.1.0",
    "@spectyra/feature-detection": "workspace:^0.1.0",
    "@spectyra/learning": "workspace:^0.1.1",
    "@spectyra/optimization-engine": "workspace:^0.1.0",
    "@spectyra/shared": "workspace:^0.1.1",
    "@spectyra/state-delta": "workspace:^0.1.0",
    "@spectyra/workflow-policy": "workspace:^0.1.0",
    "@types/node": "^20.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.7.1",
    "typescript": "~5.4.0"
  }
}
