{
  "name": "@spectyra/devtools",
  "version": "0.1.10",
  "description": "Lit + re-exports for Spectyra browser devtools and monitor strip (pairs with SDK Phase 6 dev bridge)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "default": "./dist/auto.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "publish:npm": "node ../../tools/npm-publish-spectyra.mjs"
  },
  "keywords": [
    "spectyra",
    "devtools",
    "monitoring",
    "llm",
    "lit",
    "cost"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spectyra/spectyra.git",
    "directory": "packages/devtools"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@spectyra/sdk": "workspace:^0.1.19",
    "lit": "^3.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "~5.4.0"
  }
}
