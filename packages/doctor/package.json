{
  "name": "@spectyra/doctor",
  "version": "0.1.0",
  "description": "Spectyra Integration Doctor — scan projects for AI calls and Spectyra setup guidance",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "spectyra-doctor": "./dist/cli.js",
    "doctor": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-ui-assets.js",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "publish:npm": "node ../../tools/npm-publish-spectyra.mjs"
  },
  "keywords": [
    "spectyra",
    "llm",
    "integration",
    "cli"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/spectyra/spectyra.git",
    "directory": "packages/doctor"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.21.2",
    "fast-glob": "^3.3.3",
    "open": "^10.1.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "typescript": "~5.4.0",
    "vitest": "^2.1.6"
  }
}
